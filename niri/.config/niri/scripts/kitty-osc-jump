#!/usr/bin/env bash
# Respond to a kitty OSC-notify notification (Claude Code et al).
#
# Kitty's terminal notification protocol attaches a default action to
# every notification it sends. When invoked, kitty focuses the exact
# terminal window that emitted the notification.
set -e

kitty_id=$(qs ipc call notifications list 2>/dev/null \
    | jq -r 'map(select(.app_name == "kitty")) | .[0].id // empty' 2>/dev/null)

if [ -n "$kitty_id" ]; then
    qs ipc call notifications invoke "$kitty_id" >/dev/null 2>&1 || true
    qs ipc call notifications dismiss "$kitty_id" >/dev/null 2>&1 || true
fi
