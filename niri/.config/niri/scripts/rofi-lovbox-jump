#!/usr/bin/env bash
# Rofi picker over the user's previously-visited lovbox sandboxes.
#
# Personal "have I been here" view backed by ~/.local/state/lovssh/history.jsonl
# (appended by `lovssh`). Optional labels in ~/.local/state/lovssh/names.json
# (managed by `lov-name`) get prepended for readability.
#
# Row format:
#   <label-or-short-project>   <relative time>
#
# Selecting opens a fresh kitty running `lovssh <last-input-for-that-claim>`.

set -uo pipefail

HISTORY_FILE="$HOME/.local/state/lovssh/history.jsonl"
NAMES_FILE="$HOME/.local/state/lovssh/names.json"

if [ ! -s "$HISTORY_FILE" ]; then
    chosen=$(printf '%s' "[empty] run lovssh <url> once to populate this list" \
        | rofi -dmenu -p "lovbox" -theme-str 'window { width: 60em; }')
    if [ -n "$chosen" ]; then
        exec kitty --title "lovssh: setup" -- fish -c \
            "echo 'Paste a project URL, then run: lovssh <url>'; read -P 'URL: ' url; lovssh \$url; read -P 'Press enter to close: '"
    fi
    exit 0
fi

# Build menu lines via jq, then read into an associative array so the
# selected display label can be mapped back to the URL/claim input.
# Relative-time helper inside jq: today / yesterday / Nd ago.
declare -A row_to_input
menu_lines=""
while IFS=$'\t' read -r claim project_id ts input label branch; do
    [ -z "$claim" ] && continue
    short_pid="${project_id:0:8}"
    [ -z "$short_pid" ] && short_pid="(no project id)"

    # Pick the visible identifier: label > short project id > short claim.
    if [ -n "$label" ]; then
        identity="$label"
    else
        identity="$short_pid"
    fi

    # Relative time. `date -d` parses the ISO timestamp.
    epoch=$(date -u -d "$ts" +%s 2>/dev/null || echo 0)
    now=$(date -u +%s)
    diff=$((now - epoch))
    if [ $diff -lt 60 ]; then        rel="just now"
    elif [ $diff -lt 3600 ]; then    rel="$((diff / 60))m ago"
    elif [ $diff -lt 86400 ]; then   rel="$((diff / 3600))h ago"
    elif [ $diff -lt 604800 ]; then  rel="$((diff / 86400))d ago"
    else                             rel=$(date -u -d "$ts" +%Y-%m-%d 2>/dev/null || echo "$ts")
    fi

    # Two-column compact line. Branch (if known) shows in dim parens.
    if [ -n "$branch" ]; then
        label_line="$identity  ($branch)  $rel"
    else
        label_line="$identity  $rel"
    fi
    menu_lines+="$label_line"$'\n'
    row_to_input["$label_line"]="$input"
done < <(
    jq -sr --slurpfile names <(test -s "$NAMES_FILE" && cat "$NAMES_FILE" || echo '{}') '
        ($names[0] // {}) as $labels
        | map(select(.claim and (.claim | length > 0)))
        | group_by(.claim)
        | map(max_by(.timestamp))
        | sort_by(.timestamp) | reverse
        | .[]
        | [.claim, .project_id, .timestamp, .input, ($labels[.claim] // ""), (.branch // "")]
        | @tsv
    ' "$HISTORY_FILE"
)

menu_lines="${menu_lines%$'\n'}"

chosen=$(printf '%s' "$menu_lines" | rofi \
    -dmenu \
    -i \
    -p "lovbox" \
    -no-custom)

[ -z "$chosen" ] && exit 0

input="${row_to_input[$chosen]}"
[ -z "$input" ] && exit 0

exec kitty --title "lovssh: $input" -- fish -c "lovssh '$input'; read -P 'Press enter to close: '"
