#!/usr/bin/env bash
# Open a kitty and run ws-startlovbox (fzf picker over lovssh history,
# then ws-createlovbox to respawn the 4-window stack). The kitty floats
# via the `lovable_picker` window-rule in niri config.
#
# Pass --here through to spawn on the currently-focused workspace.
set -euo pipefail
ARGS="$*"
exec kitty --class lovable_picker bash -c "
source \"\$HOME/.config/themes/load-fzf-bash.sh\" 2>/dev/null || true
exec \"\$HOME/.config/niri/scripts/ws-startlovbox\" $ARGS
"
