#!/usr/bin/env bash
# Focus Slack and open the exact channel that just notified.
#
# Slack registers a default action on every notification. Quickshell's
# IPC invokes it via DBus, and Slack responds by opening the right
# channel and focusing its window.
#
# Fallback: if no live notification (already dismissed/expired), focus
# Slack via jump-or-exec and let the user navigate.
set -e

DIR=$(dirname "$0")

slack_id=$(qs ipc call notifications list 2>/dev/null \
    | jq -r 'map(select(.app_name == "Slack")) | .[0].id // empty' 2>/dev/null)

if [ -n "$slack_id" ]; then
    qs ipc call notifications invoke "$slack_id" >/dev/null 2>&1 || true
    qs ipc call notifications dismiss "$slack_id" >/dev/null 2>&1 || true
    # If Slack's DBus action didn't grab focus (focus-stealing prevention,
    # Slack on a different niri workspace), fall back to niri-jump-or-exec.
    sleep 0.05
    focused_app=$(niri msg --json focused-window 2>/dev/null | jq -r '.app_id // empty' 2>/dev/null)
    if [ "$focused_app" != "Slack" ]; then
        "$DIR/niri-jump-or-exec" Slack slack || true
    fi
else
    "$DIR/niri-jump-or-exec" Slack slack || true
fi
