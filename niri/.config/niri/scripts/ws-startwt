#!/usr/bin/env python3
"""
ws-startwt — fzf picker over existing worktrees AND LoL sandboxes,
then ws-createwt or ws-createlovbox respectively.

Workspace-stack version of startwt. Run inside a kitty so fzf has a
TTY (rofi-ws-startwt wraps that).

Rows are tagged in the leading column:
    wt   <branch>     <path>
    ssh  <name>       <claim>  (last-seen)

Worktree rows go through the existing claude-mode picker
(new/resume/fork) before forwarding to ws-createwt. SSH rows skip that
prompt and forward directly to ws-createlovbox.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

HOME = os.environ["HOME"]
LOVABLE_DIR = Path(HOME) / "work" / "lovable"
HIST = Path(HOME) / ".local" / "state" / "lovssh" / "history.jsonl"


def list_worktrees() -> list[tuple[str, str]]:
    """Return [(branch, path)] for each worktree under ~/work/lovable,
    excluding the primary tree (~/work/lovable on `main` — reached via
    Super+O instead)."""
    out = subprocess.run(
        ["git", "-C", str(LOVABLE_DIR), "worktree", "list", "--porcelain"],
        capture_output=True, text=True,
    ).stdout
    rows: list[tuple[str, str]] = []
    cur_path = ""
    for line in out.splitlines():
        if line.startswith("worktree "):
            cur_path = line.split(" ", 1)[1]
        elif line.startswith("branch "):
            branch = line.split(" ", 1)[1].removeprefix("refs/heads/")
            if cur_path.endswith("/lovable") or branch == "main":
                continue
            rows.append((branch, cur_path))
    return rows


def list_sandboxes() -> list[dict]:
    """Read lovssh history, dedupe by claim (most-recent wins), sort by
    timestamp desc."""
    if not HIST.is_file():
        return []
    by_claim: dict[str, dict] = {}
    for line in HIST.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            e = json.loads(line)
        except json.JSONDecodeError:
            continue
        claim = e.get("claim")
        if not claim:
            continue
        prev = by_claim.get(claim)
        if prev is None or e.get("timestamp", "") > prev.get("timestamp", ""):
            by_claim[claim] = e
    return sorted(by_claim.values(), key=lambda e: e.get("timestamp", ""), reverse=True)


def derive_sandbox_name(e: dict) -> str:
    """Pick the most identifiable short name for ws-createlovbox.
    Prefer daphen branch suffix, fall back to non-ephemeral HEAD, then claim."""
    db = e.get("daphen_branch") or ""
    if db.startswith("daphen/"):
        return db.removeprefix("daphen/")
    if db:
        return db
    head = e.get("branch") or ""
    if head and not head.startswith("edit/edt-"):
        return head
    claim = e.get("claim") or ""
    return claim.removeprefix("lovable-") or "scratch"


def fzf(lines: list[str], prompt: str, header: str = "") -> str | None:
    if not lines:
        return None
    args = ["fzf", "--prompt", prompt, "--height=60%", "--reverse", "--no-sort"]
    if header:
        args += ["--header", header]
    p = subprocess.run(args, input="\n".join(lines), capture_output=True, text=True)
    return p.stdout.strip() or None


def handle_worktree_pick(branch: str, picked_path: str) -> int:
    # Derive the worktree short name from the on-disk dir, not the
    # branch. Branches get renamed independently of the directory
    # (e.g. after `git branch -m`) and ws-createwt reconstructs the
    # dir path from this name — using a mismatched branch name lands
    # us on a path that doesn't exist and ws-createwt then fails to
    # `wt switch --create` against an already-checked-out branch.
    name = Path(picked_path).name.removeprefix("lovable.daphen-")

    mode = fzf(
        ["new", "resume", "fork"],
        "claude session> ",
        header=f"Claude session for {name}",
    ) or "new"

    cmd = [str(Path(__file__).parent / "ws-createwt"), name, "--mode", mode]
    if mode in ("resume", "fork"):
        sid = subprocess.run(
            [str(Path(HOME) / ".config/niri/scripts/spawn-claude-session-picker"),
             "--id-only"],
            capture_output=True, text=True,
        ).stdout.strip()
        if sid:
            cmd += ["--session-id", sid]
        else:
            return 0
    return subprocess.run(cmd).returncode


def handle_sandbox_pick(name: str, claim: str) -> int:
    cmd = [str(Path(__file__).parent / "ws-createlovbox"), name, claim]
    return subprocess.run(cmd).returncode


def worktree_mtime(path: str) -> float:
    try:
        return os.stat(path).st_mtime
    except OSError:
        return 0.0


def sandbox_unix(e: dict) -> float:
    ts = e.get("timestamp") or ""
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except (ValueError, TypeError):
        return 0.0


def main() -> int:
    worktrees = list_worktrees()
    sandboxes = list_sandboxes()

    if not worktrees and not sandboxes:
        print("no worktrees or lovssh history found", file=sys.stderr)
        return 1

    # Build rows as (sort_key, kind, name, target, display) and sort
    # newest first across both kinds, so a freshly-touched SSH sandbox
    # outranks an old worktree and vice versa.
    rows: list[tuple[float, str, str, str, str]] = []
    for branch, path in worktrees:
        rows.append((worktree_mtime(path), "wt", branch, path, f"wt\t{branch}\t{path}"))
    for e in sandboxes:
        name = derive_sandbox_name(e)
        claim = e.get("claim", "?")
        when = (e.get("timestamp") or "")[:10]
        # Pass URL form to ws-createlovbox when project_id is known so its
        # browser pane lands on the actual project preview instead of the
        # dashboard. Display still shows the claim for readability.
        pid = e.get("project_id") or ""
        target = f"https://lovable.dev/projects/{pid}" if pid else claim
        rows.append((sandbox_unix(e), "ssh", name, target, f"ssh\t{name}\t{claim}  ({when})"))

    rows.sort(key=lambda r: r[0], reverse=True)
    display = [r[4] for r in rows]

    pick = fzf(
        display,
        "stack> ",
        header="Resume a worktree (wt) or LoL sandbox (ssh); stack respawns on a new workspace",
    )
    if not pick:
        return 0

    kind, name_or_branch, _target = pick.split("\t", 2)
    matched = next(
        (r for r in rows if r[1] == kind and r[2] == name_or_branch),
        None,
    )
    if matched is None:
        print(f"couldn't match pick back to a row: {pick!r}", file=sys.stderr)
        return 1

    _ts, _kind, name_or_branch, target, _disp = matched
    if kind == "wt":
        return handle_worktree_pick(name_or_branch, target)
    else:
        return handle_sandbox_pick(name_or_branch, target)


if __name__ == "__main__":
    sys.exit(main())
