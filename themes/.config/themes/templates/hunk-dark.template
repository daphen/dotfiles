# Hunk diff viewer — palette-driven override (dark)
# Generated from colors.json via theme-processor.
# Schema reverse-engineered from hunkdiff's main.js:
#   CUSTOM_THEME_COLOR_KEYS   — 31 structural keys (background, panel, addedBg, etc.)
#   CUSTOM_SYNTAX_COLOR_KEYS  — 9 syntax keys (default, keyword, string, comment,
#                               number, function, property, type, punctuation)
# Anything outside those two allowlists is silently dropped — older drafts
# of this template used `addition`/`deletion`/`gutter`/`lineNumber` which
# all silently fell through to the base theme. Now using the real names.

theme = "custom"

[custom_theme]
base       = "midnight"
label      = "Daphen Dark"

# ── Chrome / panels ──────────────────────────────────────────────────
background  = "{{background.primary}}"
panel       = "{{background.surface}}"
panelAlt    = "{{background.overlay}}"
border      = "{{background.overlay}}"
text        = "{{foreground.primary}}"
muted       = "{{foreground.muted}}"
accent      = "{{semantic.cursor}}"
accentMuted = "{{accent.cyan}}"

# ── Line numbers / gutter ────────────────────────────────────────────
lineNumberBg = "{{background.surface}}"
lineNumberFg = "{{foreground.muted}}"

# ── Diff line backgrounds (the +/- whole-line tints) ─────────────────
addedBg          = "{{semantic.highlight_succ}}"
removedBg        = "{{semantic.highlight_err}}"
contextBg        = "{{background.primary}}"

# Content-region tints — the slightly different shade hunk paints inside
# changed runs vs surrounding context. Use the *_dim semantic colors so
# they sit one notch darker than the headline tint.
addedContentBg   = "{{semantic.highlight_succ_dim}}"
removedContentBg = "{{semantic.highlight_err_dim}}"
contextContentBg = "{{background.surface}}"

# +/- sign-column chars
addedSignColor   = "{{accent.green}}"
removedSignColor = "{{accent.red}}"

# Currently-selected hunk highlight
selectedHunk     = "{{background.selection}}"

# ── File-status badges in the sidebar ────────────────────────────────
badgeAdded     = "{{accent.green}}"
badgeRemoved   = "{{accent.red}}"
badgeNeutral   = "{{foreground.muted}}"
fileNew        = "{{accent.green}}"
fileDeleted    = "{{accent.red}}"
fileRenamed    = "{{accent.orange}}"
fileModified   = "{{accent.blue}}"
fileUntracked  = "{{foreground.muted}}"

# ── Agent note callouts ──────────────────────────────────────────────
noteBorder          = "{{accent.cyan}}"
noteBackground      = "{{background.surface}}"
noteTitleBackground = "{{background.overlay}}"
noteTitleText       = "{{foreground.primary}}"

[custom_theme.syntax]
default     = "{{foreground.primary}}"
keyword     = "{{semantic.keyword}}"
string      = "{{semantic.string}}"
comment     = "{{semantic.comment}}"
number      = "{{semantic.number}}"
function    = "{{semantic.function}}"
property    = "{{semantic.property}}"
type        = "{{semantic.type}}"
punctuation = "{{foreground.muted}}"
